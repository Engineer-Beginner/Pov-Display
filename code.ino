int letterSpace;
int dotTime;

void setup()
{ 
  Serial.begin(9600);
  // Cài đặt các chân led làm OUTPUT
  for( int i = 2; i<10 ;i++ )
  { 
    pinMode(i, OUTPUT);
  }

  letterSpace = 6; // Khoảng cách giữa các chữ (ms)
  dotTime = 1;     // Thời gian hiển thị mỗi cột (ms)
}

void printLetter(int letter[])
{
  int y;
  
  // Cột 1: Thêm dấu '!' để đảo ngược logic chữ
  for (y=0; y<8; y++)
  {
    digitalWrite(y+2, !letter[y]); 
  }
  delay(dotTime);
  
  // Cột 2
  for (y=0; y<8; y++)
  {
    digitalWrite(y+2, !letter[y+8]);
  }
  delay(dotTime);
  
  // Cột 3
  for (y=0; y<8; y++)
  {
    digitalWrite(y+2, !letter[y+16]);
  }
  delay(dotTime);
  
  // Cột 4
  for(y = 0; y<8; y++) {
    digitalWrite(y+2, !letter[y+24]);
  }
  delay(dotTime);
  
  // Cột 5
  for(y = 0; y<8; y++) {
    digitalWrite(y+2, !letter[y+32]);
  }
  delay(dotTime);
  
  // Khoảng cách giữa các chữ: Đổi từ 0 thành 1 để TẮT tất cả LED ở Active-Low
  for (y=0; y<8; y++)
  {
    digitalWrite(y+2, 1); 
  }
  delay(letterSpace);
}

void loop() 
{
  // Lặp lại chữ "ECE 100" 50 lần 
  // (Tương đương hiện chữ này trong khoảng 2-3 giây tùy tốc độ chạy code)
  for (int i = 0; i < 40; i++) {
    printLetter(E);
    printLetter(C);
    printLetter(E);
    // printLetter(_); 
    printLetter(NUMBER1);
    printLetter(NUMBER0);
    printLetter(NUMBER0);
    
    // Khoảng trắng để tách các chữ ECE 100 ra khỏi nhau khi lặp lại
    printLetter(_);
    printLetter(_);
    printLetter(_);
  }

  // Sau khi xong, chuyển sang lặp lại chữ "TIEN" 50 lần
  for (int i = 0; i < 50; i++) {
    printLetter(T);
    printLetter(I);
    printLetter(E);
    printLetter(N);
    printLetter(1);
    printLetter(0);
    
    // Khoảng trắng để tách các chữ TIEN ra khỏi nhau khi lặp lại
    printLetter(_);
    printLetter(_);
    printLetter(_);
  }
}